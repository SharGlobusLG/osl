<odoo>
    <data>

        <record id="osl_hospital_type_disease_list" model="ir.ui.view">
            <field name="name">osl.hospital.type.disease.list ()</field>
            <field name="model">osl.hospital.type.disease</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="description"/>
                </list>
            </field>
        </record>

        <record id="osl_hospital_type_disease_form" model="ir.ui.view">
            <field name="name">osl.hospital.type.disease.form ()</field>
            <field name="model">osl.hospital.type.disease</field>
            <field name="arch" type="xml">
                <form>
                    <header></header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="description"/>
                            </group>
                            <!--group>
                                <field name="res_partner_id"/>
                                <field name="res_partner_ids" widget="many2many_tags"
                                       options="{'color_field': 'color'}"/>
                            </group-->
                        </group>
                    </sheet>
                </form>
            </field>
        </record>


        <record id="action_osl_hospital_type_disease_window" model="ir.actions.act_window">
            <field name="name">Type Disease</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">osl.hospital.type.disease</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="osl_hospital_menu_type_disease"
                  action="action_osl_hospital_type_disease_window"
                  parent="odoo_hospital_menu_catalog"
                  name="Type Disease" sequence="200"/>

    </data>
</odoo>