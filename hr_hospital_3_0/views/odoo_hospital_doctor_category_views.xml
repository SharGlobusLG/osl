<odoo>
    <data>

        <record id="osl_hospital_doctor_category_list" model="ir.ui.view">
            <field name="name">osl.hospital.doctor.category.list ()</field>
            <field name="model">osl.hospital.doctor.category</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="osl_hospital_doctor_category_form" model="ir.ui.view">
            <field name="name">osl.hospital.doctor.category.form ()</field>
            <field name="model">osl.hospital.doctor.category</field>
            <field name="arch" type="xml">
                <form>
                    <header>Header Doc category</header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                            </group>
                            <group>
                                <field name="osl_doctor_ids">
                                    <list>
                                        <field name="name"/>
                                    </list>
                                </field>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_osl_hospital_doctor_category_window" model="ir.actions.act_window">
            <field name="name">Doctor Category Win</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">osl.hospital.doctor.category</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="osl_hospital_menu_doctor_category"
                  action="action_osl_hospital_doctor_category_window"
                  parent="odoo_hospital_menu_catalog"
                  name="Doctor's Catergories" sequence="200"/>

    </data>
</odoo>
