<odoo>
    <data>

        <record id="up_payment_view_search" model="ir.ui.view">
            <field name="name">up.payment.search</field>
            <field name="model">up.payment</field>
            <field name="arch" type="xml">
                <search string="Charges">

                    <filter name="state_draft"
                            string="Draft"
                            domain="[('state', '=', 'draft')]"/>
                    <filter name="filter_borrowed"
                            string="Approved"
                            domain="[('state', '=', 'approved')]"/>
                    <separator/>

                    <group>
                        <filter name="state" string="State" context="{'group_by': 'state'}"/>
                    </group>

                    <searchpanel>
                        <field name="apartment_id"
                               string="Apartment"
                               icon="fa-flag"
                               enable_counters="1"/>
                    </searchpanel>
                </search>
            </field>
        </record>

        <record model="ir.ui.view" id="up_payment_list">
            <field name="name">up.payment.list ()</field>
            <field name="model">up.payment</field>
            <field name="arch" type="xml">
                <list>
                    <field name="state"/>
                    <field name="create_date"/>
                    <field name="apartment_id"/>
                    <field name="total_sum"/>
                </list>
            </field>
        </record>

        <record model="ir.ui.view" id="up_payment_form">
            <field name="name">up.payment.form ()</field>
            <field name="model">up.payment</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_reload_lines"
                                type="object"
                                string="Reload lines"
                                class="secondary"
                                confirm="Are you sure Reload lines ?"
                                invisible="state != 'draft'"
                        />

                        <button name="action_approve"
                                type="object"
                                string="Approve"
                                class="btn-primary"
                                confirm="Are you sure Approve ?"
                                invisible="state != 'draft'"
                        />

                        <button name="action_reject"
                                type="object"
                                string="Reject"
                                class="btn-warning"
                                confirm="Are you sure Reject ?"
                                invisible="state != 'approved'"
                        />
                        <field name="state"
                               widget="statusbar"/>
                    </header>
                    <group>
                        <field name="state" invisible="true"/>
                        <field name="apartment_id" readonly="state == 'approved'"/>
                        <field name="create_date" readonly="true"/>

                    </group>
                    <notebook>
                        <page string="Utility list" name="utility_list">
                            <field name="payment_line_ids" readonly="state == 'approved'">
                                <list editable="bottom">
                                    <field name="period_id"/>
                                    <field name="product_id"/>
                                    <field name="type_utility_id"/>
                                    <field name="personal_account"/>
                                    <field name="provider_id"/>
                                    <field name="sum" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </form>
            </field>
        </record>


        <record id="up_payment_view_kanban" model="ir.ui.view">
            <field name="name">up.payment.kanban</field>
            <field name="model">up.payment</field>
            <field name="priority">50</field>
            <field name="arch" type="xml">
                <kanban sample="1"
                        default_group_by="state"
                        records_draggable="false"
                        group_create="False"
                        group_delete="False"
                        group_edit="False">

                    <header></header>

                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_card">
                                <div>
                                    <strong>
                                        <field name="apartment_id"/>
                                    </strong>
                                </div>

                                <div class="mt-2">
                                    Sum:
                                    <field name="total_sum"/>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record model="ir.actions.act_window" id="up_payment_action_window">
            <field name="name">Payment</field>
            <field name="res_model">up.payment</field>
            <field name="view_mode">list,form,search,kanban</field>
        </record>


        <!-- server action to the one above -->
        <!--
            <record model="ir.actions.server" id="utility_pyments.action_server">
              <field name="name">utility_pyments server</field>
              <field name="model_id" ref="model_utility_pyments_utility_pyments"/>
              <field name="state">code</field>
              <field name="code">
                action = {
                  "type": "ir.actions.act_window",
                  "view_mode": "list,form",
                  "res_model": model._name,
                }
              </field>
            </record>
        -->

        <menuitem id="ut_payment_menu_item"
                  name="Payment"
                  parent="up_payments_menu"
                  action="up_payment_action_window"
                  sequence="20"/>
    </data>
</odoo>