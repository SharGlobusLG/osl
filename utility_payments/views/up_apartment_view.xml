<odoo>
    <data>
        <record model="ir.ui.view" id="up_apartment_list">
            <field name="name">up.apartment.list ()</field>
            <field name="model">up.apartment</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="address"/>
                </list>
            </field>
        </record>

        <record model="ir.ui.view" id="up_apartment_form">
            <field name="name">up.apartment.form ()</field>
            <field name="model">up.apartment</field>
            <field name="arch" type="xml">
                <form>
                    <header></header>
                    <sheet>
                        <widget name="web_ribbon"
                                title="Archived"
                                bg_color="text-bg-danger"
                                invisible="active"/>
                        <group>
                            <field name="name" invisible="true"/>
                            <field name="name"/>
                            <field name="address"/>
                        </group>
                        <notebook>
                            <page string="Utility list" name="utility_list">
                                <field name="apartment_utility_ids">
                                    <list editable="bottom">
                                        <field name="apartment_id" column_invisible="True"/>
                                        <field name="product_id"/>
                                        <field name="type_utility_id"/>
                                        <field name="calc_type"/>
                                        <field name="fixed_sum" widget="monetary"
                                               options="{'currency_field': 'currency_id'}"
                                               readonly="calc_type!='fixed'"/>
                                        <field name="currency_id" column_invisible="True"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>

                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="up_apartment_action_window">
            <field name="name">Apartment</field>
            <field name="res_model">up.apartment</field>
            <field name="view_mode">list,form</field>
        </record>


        <!-- server action to the one above -->
        <!--
            <record model="ir.actions.server" id="utility_pyments.action_server">
              <field name="name">utility_pyments server</field>
              <field name="model_id" ref="model_utility_pyments_utility_pyments"/>
              <field name="state">code</field>
              <field name="code">
                action = {
                  "type": "ir.actions.act_window",
                  "view_mode": "list,form",
                  "res_model": model._name,
                }
              </field>
            </record>
        -->

        <menuitem id="ut_apartment_menu_item"
                  name="Apartment"
                  parent="up_general_data_menu"
                  action="up_apartment_action_window"
                  sequence="10"/>
    </data>
</odoo>