<odoo>
    <data>

        <record id="up_apartment_view_search" model="ir.ui.view">
            <field name="name">up.apartment.search</field>
            <field name="model">up.apartment</field>
            <field name="arch" type="xml">
                <search string="Apartment search">
                    <filter name="active" string="Include inactive" domain="[('active', 'in', ('false','true'))]"/>
                </search>
            </field>
        </record>


        <record model="ir.ui.view" id="up_apartment_list">
            <field name="name">up.apartment.list ()</field>
            <field name="model">up.apartment</field>
            <field name="arch" type="xml">
                <list decoration-muted="not active" decoration-success="active">
                    <field name="active" widget="boolean_toggle" readonly="true"/>
                    <field name="name"/>
                    <field name="address"/>
                    <field name="user_id" widget="many2one_avatar_user"/>
                </list>
            </field>
        </record>

        <record model="ir.ui.view" id="up_apartment_form">
            <field name="name">up.apartment.form ()</field>
            <field name="model">up.apartment</field>
            <field name="arch" type="xml">
                <form>
                    <header></header>
                    <sheet>
                        <widget name="web_ribbon"
                                title="Archived"
                                bg_color="text-bg-danger"
                                invisible="active"/>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="address"/>
                            </group>
                            <group>
                                <field name="active" widget="boolean_toggle"/>
                                <field name="user_id"/>
                            </group>

                        </group>
                        <notebook>
                            <page string="Utility list" name="utility_list">
                                <field name="apartment_utility_ids">
                                    <list editable="bottom">
                                        <field name="apartment_id" column_invisible="True"/>
                                        <field name="product_id"/>
                                        <field name="type_utility_id"/>
                                        <field name="calc_type"/>
                                        <field name="fixed_sum" widget="monetary"
                                               options="{'currency_field': 'currency_id'}"
                                               readonly="calc_type!='fixed'" sum="Total sum"/>
                                        <field name="currency_id" column_invisible="True"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>

                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="up_apartment_action_window">
            <field name="name">Apartment</field>
            <field name="res_model">up.apartment</field>
            <field name="view_mode">list, form, search</field>
        </record>

        <menuitem id="ut_apartment_menu_item"
                  name="Apartment"
                  parent="up_general_data_menu"
                  action="up_apartment_action_window"
                  sequence="10"/>
    </data>
</odoo>