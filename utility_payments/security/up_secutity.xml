<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="up_charge_rule_user" model="ir.rule">
        <field name="name">(UP) Charge - User</field>
        <field name="model_id" ref="model_up_charge"/>
        <field name="domain_force">[('apartment_id.user_id.id', '=', user.id)]</field>
        <field name="groups" eval="[
                Command.link(ref('up_group_user')),
            ]"/>
    </record>

    <record id="up_payment_rule_user" model="ir.rule">
        <field name="name">(UP) Payment - User</field>
        <field name="model_id" ref="model_up_payment"/>
        <field name="domain_force">[('apartment_id.user_id.id', '=', user.id)]</field>
        <field name="groups" eval="[
                Command.link(ref('up_group_user')),
            ]"/>
    </record>

    <record id="up_charge_rule_admin" model="ir.rule">
        <field name="name">(UP) Charge - Administrator</field>
        <field name="model_id" ref="model_up_charge"/>
        <field name="domain_force">[]</field>
        <field name="groups" eval="[
                Command.link(ref('up_group_administrator')),
            ]"/>
    </record>

    <record id="up_payment_rule_admin" model="ir.rule">
        <field name="name">(UP) Payment - Administrator</field>
        <field name="model_id" ref="model_up_payment"/>
        <field name="domain_force">[]</field>
        <field name="groups" eval="[
                Command.link(ref('up_group_administrator')),
            ]"/>
    </record>

</odoo>