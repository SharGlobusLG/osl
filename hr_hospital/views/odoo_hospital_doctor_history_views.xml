<odoo>
    <data>

        <record id="osl_hospital_doctor_history_list" model="ir.ui.view">
            <field name="name">osl.hospital.doctor.history.list ()</field>
            <field name="model">osl.hospital.doctor.history</field>
            <field name="arch" type="xml">
                <list>
                    <field name="display_name"/>
                    <field name="patient_id"/>
                    <field name="doctor_id"/>
                    <field name="set_date"/>
                    <field name="exchange_date"/>
                </list>
            </field>
        </record>

        <record id="osl_hospital_doctor_history_form" model="ir.ui.view">
            <field name="name">osl.hospital.doctor.history.form ()</field>
            <field name="model">osl.hospital.doctor.history</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group col="1">
                            <group>
                                <field name="patient_id"/>
                                <field name="doctor_id"/>
                                <field name="set_date"/>
                                <field name="exchange_date"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>


        <record id="action_osl_hospital_doctor_history_window" model="ir.actions.act_window">
            <field name="name">History</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">osl.hospital.doctor.history</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="osl_hospital_menu_doctor_history"
                  action="action_osl_hospital_doctor_history_window"
                  parent="odoo_hospital_menu_catalog"
                  name="History" sequence="200"/>

    </data>
</odoo>