<odoo>
    <data>

        <record id="osl_hospital_patient_list" model="ir.ui.view">
            <field name="name">osl.hospital.patient.list ()</field>
            <field name="model">osl.hospital.patient</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="description"/>
                    <field name="doctor_id"/>
                    <field name="insurance_policy_number"/>
                    <field name="blood_type"/>
                    <field name="gender"/>
                    <field name="birth_date"/>
                    <field name="age"/>
                </list>
            </field>
        </record>

        <record id="osl_hospital_patient_form" model="ir.ui.view">
            <field name="name">osl.hospital.patient.form ()</field>
            <field name="model">osl.hospital.patient</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <div class="oe_button_box" name="button_box">
                            <button name="show_appointments"
                                    string="Show Appointments"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-list">
                                <field name="count_appointments" widget="statinfo" string="Show Appointments"/>
                            </button>

                            <!--Виклик Пітон метод є найбільш гнучким рішенням з усіх.
                            У майбутньому його простіше розширювати.-->
                            <button name="new_appointments"
                                    string="New Appointment"
                                    type="object"
                                    class="btn-primary"
                                    icon="fa-asterisk">
                            </button>
                        </div>
                    </header>

                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="description"/>
                                <field name="phone" widget="phone"/>
                                <field name="doctor_id"/>
                                <field name="insurance_policy_number"/>
                            </group>
                            <group>
                                <field name="blood_type"/>
                                <field name="gender"/>
                                <field name="birth_date"/>
                                <field name="age"/>
                            </group>
                            <notebook>
                                <page string="Doctor's history" name="history_list">
                                    <field name="history_ids">
                                        <list>
                                            <field name="display_name"/>
                                            <field name="patient_id"/>
                                            <field name="doctor_id"/>
                                            <field name="set_date"/>
                                            <field name="exchange_date"/>
                                        </list>
                                    </field>
                                </page>
                            </notebook>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="osl_hospital_patient_view_search" model="ir.ui.view">
            <field name="name">osl.hospital.patient.search</field>
            <field name="model">osl.hospital.patient</field>
            <field name="arch" type="xml">
                <search string="Books">
                    <field name="name" string="Name"/>
                    <field name="phone" string="Phone"/>
                    <searchpanel>
                        <field name="doctor_id" string="Doctor" icon="fa-user-md" select="multi" enable_counters="1"/>
                    </searchpanel>
                </search>
            </field>
        </record>

        <record id="action_osl_hospital_patient_window" model="ir.actions.act_window">
            <field name="name">patient</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">osl.hospital.patient</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="osl_hospital_menu_patient"
                  action="action_osl_hospital_patient_window"
                  parent="odoo_hospital_menu_catalog"
                  name="Patient" sequence="200"/>

    </data>
</odoo>