<odoo>
    <data>

        <record id="osl_hospital_appointment_list" model="ir.ui.view">
            <field name="name">osl.hospital.appointment.list ()</field>
            <field name="model">osl.hospital.appointment</field>
            <field name="arch" type="xml">
                <list>
                    <field name="display_name"/>
                    <field name="state"/>
                    <field name="scheduled_date"/>
                    <field name="actual_date"/>
                    <field name="patient_id"/>
                    <field name="doctor_id"/>
                    <field name="disease_id"/>
                </list>
            </field>
        </record>

        <record id="osl_hospital_appointment_form" model="ir.ui.view">
            <field name="name">osl.hospital.appointment.form ()</field>
            <field name="model">osl.hospital.appointment</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="show_disease_like_this"
                                type="object"
                                string="Show Disease Like This"
                                class="btn-info"
                                icon="oi-odoo-list"/>
                        <field name="state"
                               widget="statusbar"
                               statusbar_visible="scheduled,completed,cancelled"
                               options="{'clickable': '1'}"/>
                    </header>

                    <sheet>
                        <group col="2">
                            <group string="Primary Details">
                                <field name="scheduled_date"/>
                                <field name="actual_date"/>
                                <field name="patient_id"/>
                                <field name="doctor_id"/>
                                <field name="disease_id"/>
                            </group>
                            <group string="Summary">
                                <field name="summary" options="{'codeview': true}" class="oe-bordered-editor"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>


        <record id="action_osl_hospital_appointment_window" model="ir.actions.act_window">
            <field name="name">Appointment</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">osl.hospital.appointment</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="osl_hospital_menu_appointment"
                  action="action_osl_hospital_appointment_window"
                  parent="odoo_hospital_menu_catalog"
                  name="Appointment" sequence="200"/>

    </data>
</odoo>