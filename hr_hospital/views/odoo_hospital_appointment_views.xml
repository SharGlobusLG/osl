<odoo>
    <data>
        <record id="osl_hospital_appointment_view_search" model="ir.ui.view">
            <field name="name">osl.hospital.appointment.search</field>
            <field name="model">osl.hospital.appointment</field>
            <field name="arch" type="xml">
                <search string="Appointments">

                    <field name="doctor_id" string="Doctor" select="multi"/>
                    <field name="patient_id" string="Patient" select="multi"/>

                    <filter name="state_filter"
                            string="Scheduled"
                            domain="[('state', '=', 'scheduled')]"/>
                    <filter name="filter_borrowed"
                            string="Completed"
                            domain="[('state', '=', 'completed')]"/>
                    <filter name="filter_lost"
                            string="Cancelled"
                            domain="[('state', '=', 'cancelled')]"/>
                    <separator/>
                    <group>
                        <filter name="state" string="State" context="{'group_by': 'state'}"/>
                    </group>

                    <searchpanel>
                        <field name="disease_id"
                               string="Disease"
                               hierarchize="1"
                               icon="fa-flag"
                               enable_counters="1"/>
                    </searchpanel>
                </search>
            </field>
        </record>

        <record id="osl_hospital_appointment_list" model="ir.ui.view">
            <field name="name">osl.hospital.appointment.list ()</field>
            <field name="model">osl.hospital.appointment</field>
            <field name="arch" type="xml">
                <list>
                    <field name="display_name"/>
                    <field name="state"/>
                    <field name="scheduled_date"/>
                    <field name="actual_date"/>
                    <field name="patient_id"/>
                    <field name="doctor_id"/>
                    <field name="disease_id"/>
                </list>
            </field>
        </record>

        <record id="osl_hospital_appointment_form" model="ir.ui.view">
            <field name="name">osl.hospital.appointment.form ()</field>
            <field name="model">osl.hospital.appointment</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <div class="oe_button_box" name="button_box">
                            <button name="show_disease_like_this"
                                    string="Show Disease..."
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-users">
                                <field name="count_same_disease" widget="statinfo" string="Show Disease Same..."/>
                            </button>
                        </div>
                        <field name="state"
                               widget="statusbar"
                               statusbar_visible="scheduled,completed,cancelled"
                               options="{'clickable': '1'}"/>
                    </header>

                    <sheet>
                        <group col="2">
                            <group string="Primary Details">
                                <field name="scheduled_date"/>
                                <field name="actual_date"/>
                                <field name="patient_id"/>
                                <field name="doctor_id"/>
                                <field name="disease_id"/>
                            </group>
                            <group string="Summary">
                                <field name="summary" options="{'codeview': true}" class="oe-bordered-editor"/>
                            </group>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="osl_hospital_appointment_view_calendar" model="ir.ui.view">
            <field name="name">osl.hospital.appointment.calendar</field>
            <field name="model">osl.hospital.appointment</field>
            <field name="arch" type="xml">
                <calendar string="Appointments"
                          create="0"
                          mode="day"
                          scales="day,week,month,year"
                          date_start="scheduled_date"
                          color="state">
                    <field name="patient_id" filters="1"/>
                    <field name="doctor_id" filters="1"/>
                </calendar>
            </field>
        </record>

        <record id="osl_hospital_appointment_view_pivot" model="ir.ui.view">
            <field name="name">osl.hospital.appointment.pivot</field>
            <field name="model">osl.hospital.appointment</field>
            <field name="arch" type="xml">
                <pivot string="Appointment Analysis" sample="1">
                    <field name="doctor_id" type="row" string="Doctor"/>
                    <field name="state" type="col" string="State"/>
                    <field name="scheduled_date"
                           interval="month"
                           type="col"/>
                </pivot>
            </field>
        </record>

        <record id="osl_hospital_appointment_view_graph" model="ir.ui.view">
            <field name="name">osl.hospital.appointment.graph</field>
            <field name="model">osl.hospital.appointment</field>
            <field name="arch" type="xml">
                <graph string="Disease by Year"
                       type="bar"
                       stacked="1"
                       sample="1">
                    <field name="scheduled_date"
                           interval="month"/>
                    <field name="disease_id"/>
                </graph>
            </field>
        </record>

        <record id="action_osl_hospital_appointment_window" model="ir.actions.act_window">
            <field name="name">Appointment</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">osl.hospital.appointment</field>
            <field name="view_mode">list,form,calendar,pivot,graph</field>
            <field name="context">
                {'search_default_filter_scheduled_date':1}
            </field>
        </record>

        <menuitem id="osl_hospital_menu_appointment"
                  action="action_osl_hospital_appointment_window"
                  parent="odoo_hospital_menu_catalog"
                  name="Appointment" sequence="200"/>

    </data>
</odoo>