<odoo>
    <template id="custom_external_layout"
              name="Custom Layout"
              inherit_id="web.external_layout_standard"
              primary="True">

        <xpath expr="//div[contains(@t-attf-class, 'footer')]//div[hasclass('o_footer_content')]" position="after">
            <table class="table table-sm table-borderless mb-3" style="width:auto">
                <tbody>
                    <tr>
                        <td class="pe-3">
                            <strong>City:</strong>
                        </td>
                        <td t-out="company.city"/>
                    </tr>
                    <tr>
                        <td class="pe-3">
                            <strong>Timestamp:</strong>
                        </td>
                        <td t-out="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d %H:%M')"/>
                    </tr>
                </tbody>
            </table>
        </xpath>
    </template>
</odoo>